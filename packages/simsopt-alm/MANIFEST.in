# The source distribution carries what its tests read besides the package:
# the golden fixtures and their scripts (tests/alm_golden) and the examples.
# The setup-skill test (tests/test_alm_setup_skill.py) also needs the
# repository around the package and runs from a checkout only.
include README.md LICENSE
graft tests
graft examples
global-exclude __pycache__ *.py[cod]
